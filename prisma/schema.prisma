generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- USER & AUTH MODELS ---
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  role              String    @default("USER") // "USER" or "ADMIN"
  isVerified        Boolean   @default(false) // <-- Added for email verification
  verificationToken String?   @unique         // <-- Added for email verification
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile           Profile?
  settings          UserSettings?
  watchlist         Watchlist[]
  favorites         Favorite[]
  progress          WatchProgress[]
  resetTokens       PasswordResetToken[]
}

model Profile {
  id          String @id @default(cuid())
  userId      String @unique
  displayName String
  avatarUrl   String?
  bio         String?

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  autoNext             Boolean @default(true)
  autoPlay             Boolean @default(false)
  enableDub            Boolean @default(false)
  showContinueWatching Boolean @default(true)
  language             String  @default("English")

  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- ANIME DATA MODELS ---
model Anime {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  alternativeTitles String?
  synopsis         String?
  posterUrl        String?
  bannerUrl        String?
  type             String?   // TV, Movie, OVA, etc.
  season           String?
  releaseYear      Int?
  status           String?   // Airing, Finished, Upcoming
  duration         String?
  score            Float?
  quality          String?   // HD, 4K
  totalEpisodes    Int?
  featured         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studioId         String?
  studio           Studio?   @relation(fields: [studioId], references: [id])
  
  genres           AnimeGenre[]
  episodes         Episode[]
  watchlist        Watchlist[]
  favorites        Favorite[]
}

model Genre {
  id    String       @id @default(cuid())
  name  String       @unique
  anime AnimeGenre[]
}

model AnimeGenre {
  animeId String
  genreId String

  anime   Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([animeId, genreId])
}

model Studio {
  id    String  @id @default(cuid())
  name  String  @unique
  anime Anime[]
}

model Episode {
  id            String    @id @default(cuid())
  animeId       String
  episodeNumber Int
  title         String?
  thumbnail     String?
  videoUrl      String?   // Authorized video source
  downloadUrls  Json?     // { "1080p": { url: "...", size: "1.2GB" } }
  releaseDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  anime         Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  progress      WatchProgress[]

  @@unique([animeId, episodeNumber])
}

// --- USER INTERACTION MODELS ---
model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  animeId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
}

model WatchProgress {
  id              String   @id @default(cuid())
  userId          String
  episodeId       String
  progressSeconds Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}